{
  "info": {
    "name": "ERIS DistanceFromHome API",
    "description": "Geocode Vietnamese addresses with Vietmap and calculate a stable traffic-free route with TomTom.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "accessToken", "value": "" }
  ],
  "item": [
    {
      "name": "01 - Login",
      "event": [{ "listen": "test", "script": { "exec": [
        "const body = pm.response.json();",
        "pm.collectionVariables.set('accessToken', body.accessToken || body.access_token || '');"
      ] } }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"hr@example.com\",\n  \"password\": \"YourPassword123!\"\n}", "options": { "raw": { "language": "json" } } },
        "url": "{{baseUrl}}/api/auth/login"
      }
    },
    {
      "name": "02 - Calculate DistanceFromHome",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"homeAddress\": \"71/26A Lãnh Binh Thắng, TP. Hồ Chí Minh\",\n  \"companyAddress\": \"FPT University, TP. Hồ Chí Minh\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/api/v1/distance/calculate"
      }
    }
  ]
}
