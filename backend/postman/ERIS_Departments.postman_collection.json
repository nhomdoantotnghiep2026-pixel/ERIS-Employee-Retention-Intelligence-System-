{
  "info": {
    "name": "ERIS Departments API",
    "description": "Collection test Departments API trên nhánh departments. Chạy request theo thứ tự từ 00 đến 05.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "adminEmail", "value": "nhomdoantotnghiep2026@gmail.com" },
    { "key": "adminPassword", "value": "NhapMatKhauAdminTaiDay123!", "type": "string" },
    { "key": "accessToken", "value": "", "type": "string" },
    { "key": "departmentId", "value": "", "type": "string" },
    { "key": "departmentName", "value": "", "type": "string" },
    { "key": "departmentDuplicateName", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "00 - Login ADMIN",
      "event": [{
        "listen": "test",
        "script": { "exec": [
          "pm.test('Login thành công', () => pm.response.to.have.status(200));",
          "if (pm.response.code === 200) pm.collectionVariables.set('accessToken', pm.response.json().accessToken);"
        ] }
      }],
      "request": {
        "auth": { "type": "noauth" },
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}", "options": { "raw": { "language": "json" } } },
        "url": "{{baseUrl}}/api/auth/login"
      }
    },
    {
      "name": "01 - List Departments",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Danh sách trả 200', () => pm.response.to.have.status(200));",
        "pm.test('Có data và pagination', () => { const b=pm.response.json(); pm.expect(b).to.have.property('data'); pm.expect(b).to.have.property('pagination'); });"
      ] } }],
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/departments?page=1&limit=10",
          "host": ["{{baseUrl}}"], "path": ["api", "departments"],
          "query": [
            { "key": "page", "value": "1" },
            { "key": "limit", "value": "10" },
            { "key": "q", "value": "engineering", "disabled": true }
          ]
        }
      }
    },
    {
      "name": "02 - Create Department",
      "event": [
        { "listen": "prerequest", "script": { "exec": [
          "pm.collectionVariables.set('departmentName', 'Postman Department ' + Date.now());"
        ] } },
        { "listen": "test", "script": { "exec": [
          "pm.test('Tạo department trả 201', () => pm.response.to.have.status(201));",
          "if (pm.response.code === 201) pm.collectionVariables.set('departmentId', String(pm.response.json().id));"
        ] } }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"{{departmentName}}\",\n  \"description\": \"Created from Postman\"\n}", "options": { "raw": { "language": "json" } } },
        "url": "{{baseUrl}}/api/departments"
      }
    },
    {
      "name": "03 - Reject Duplicate Department",
      "event": [
        { "listen": "prerequest", "script": { "exec": [
          "pm.collectionVariables.set('departmentDuplicateName', pm.collectionVariables.get('departmentName').toLowerCase());"
        ] } },
        { "listen": "test", "script": { "exec": [
          "pm.test('Department khác hoa thường vẫn trả 409', () => pm.response.to.have.status(409));",
          "pm.test('Đúng error code', () => pm.expect(pm.response.json().error.code).to.eql('DEPARTMENT_EXISTS'));"
        ] } }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"{{departmentDuplicateName}}\"\n}", "options": { "raw": { "language": "json" } } },
        "url": "{{baseUrl}}/api/departments"
      }
    },
    {
      "name": "04 - Update Department",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Cập nhật department trả 200', () => pm.response.to.have.status(200));",
        "if (pm.response.code === 200) pm.expect(pm.response.json().description).to.eql(null);"
      ] } }],
      "request": {
        "method": "PATCH",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"{{departmentName}} Updated\",\n  \"description\": null\n}", "options": { "raw": { "language": "json" } } },
        "url": "{{baseUrl}}/api/departments/{{departmentId}}"
      }
    },
    {
      "name": "05 - Department Not Found",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('ID không tồn tại trả 404', () => pm.response.to.have.status(404));",
        "pm.test('Đúng error code', () => pm.expect(pm.response.json().error.code).to.eql('DEPARTMENT_NOT_FOUND'));"
      ] } }],
      "request": {
        "method": "PATCH",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"Missing Department\"\n}", "options": { "raw": { "language": "json" } } },
        "url": "{{baseUrl}}/api/departments/999999999"
      }
    }
  ]
}
