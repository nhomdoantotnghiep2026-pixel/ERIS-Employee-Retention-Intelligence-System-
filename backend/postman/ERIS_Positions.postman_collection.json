{
  "info": {
    "name": "ERIS Positions API",
    "description": "Collection test Positions API trên nhánh positions. Chạy request theo thứ tự từ 00 đến 06. Level hợp lệ: Junior, Senior, Lead, Manager, Director.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "adminEmail", "value": "nhomdoantotnghiep2026@gmail.com" },
    { "key": "adminPassword", "value": "NhapMatKhauAdminTaiDay123!", "type": "string" },
    { "key": "accessToken", "value": "", "type": "string" },
    { "key": "positionId", "value": "", "type": "string" },
    { "key": "positionTitle", "value": "", "type": "string" },
    { "key": "positionDuplicateTitle", "value": "", "type": "string" },
    { "key": "positionLevel", "value": "Junior", "type": "string", "description": "Junior | Senior | Lead | Manager | Director" }
  ],
  "item": [
    {
      "name": "00 - Login ADMIN",
      "event": [{
        "listen": "test",
        "script": { "exec": [
          "pm.test('Login thành công', () => pm.response.to.have.status(200));",
          "if (pm.response.code === 200) pm.collectionVariables.set('accessToken', pm.response.json().accessToken);"
        ] }
      }],
      "request": {
        "auth": { "type": "noauth" },
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}", "options": { "raw": { "language": "json" } } },
        "url": "{{baseUrl}}/api/auth/login"
      }
    },
    {
      "name": "01 - List Positions",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Danh sách trả 200', () => pm.response.to.have.status(200));",
        "pm.test('Có data và pagination', () => { const b=pm.response.json(); pm.expect(b).to.have.property('data'); pm.expect(b).to.have.property('pagination'); });"
      ] } }],
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/positions?page=1&limit=10",
          "host": ["{{baseUrl}}"], "path": ["api", "positions"],
          "query": [
            { "key": "page", "value": "1" },
            { "key": "limit", "value": "10" },
            { "key": "q", "value": "engineer", "disabled": true }
          ]
        }
      }
    },
    {
      "name": "02 - Create Position",
      "event": [
        { "listen": "prerequest", "script": { "exec": [
          "pm.collectionVariables.set('positionTitle', 'Postman Position ' + Date.now());"
        ] } },
        { "listen": "test", "script": { "exec": [
          "pm.test('Tạo position trả 201', () => pm.response.to.have.status(201));",
          "if (pm.response.code === 201) pm.collectionVariables.set('positionId', String(pm.response.json().id));"
        ] } }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"title\": \"{{positionTitle}}\",\n  \"level\": \"{{positionLevel}}\",\n  \"description\": \"Created from Postman\"\n}", "options": { "raw": { "language": "json" } } },
        "url": "{{baseUrl}}/api/positions"
      }
    },
    {
      "name": "03 - Get Position Detail",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Chi tiết position trả 200', () => pm.response.to.have.status(200));",
        "if (pm.response.code === 200) pm.expect(String(pm.response.json().data.id)).to.eql(pm.collectionVariables.get('positionId'));"
      ] } }],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/positions/{{positionId}}"
      }
    },
    {
      "name": "04 - Reject Duplicate Position",
      "event": [
        { "listen": "prerequest", "script": { "exec": [
          "pm.collectionVariables.set('positionDuplicateTitle', pm.collectionVariables.get('positionTitle').toLowerCase());"
        ] } },
        { "listen": "test", "script": { "exec": [
          "pm.test('Position khác hoa thường vẫn trả 409', () => pm.response.to.have.status(409));",
          "pm.test('Đúng error code', () => pm.expect(pm.response.json().error.code).to.eql('POSITION_EXISTS'));"
        ] } }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"title\": \"{{positionDuplicateTitle}}\",\n  \"level\": \"{{positionLevel}}\"\n}", "options": { "raw": { "language": "json" } } },
        "url": "{{baseUrl}}/api/positions"
      }
    },
    {
      "name": "05 - Update Position",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Cập nhật position trả 200', () => pm.response.to.have.status(200));",
        "if (pm.response.code === 200) { const b=pm.response.json(); pm.expect(b.level).to.eql('Senior'); pm.expect(b.description).to.eql(null); }"
      ] } }],
      "request": {
        "method": "PATCH",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"level\": \"Senior\",\n  \"description\": null\n}", "options": { "raw": { "language": "json" } } },
        "url": "{{baseUrl}}/api/positions/{{positionId}}"
      }
    },
    {
      "name": "06 - Position Not Found",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('ID không tồn tại trả 404', () => pm.response.to.have.status(404));",
        "pm.test('Đúng error code', () => pm.expect(pm.response.json().error.code).to.eql('POSITION_NOT_FOUND'));"
      ] } }],
      "request": {
        "method": "PATCH",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"title\": \"Missing Position\"\n}", "options": { "raw": { "language": "json" } } },
        "url": "{{baseUrl}}/api/positions/999999999"
      }
    }
  ]
}
