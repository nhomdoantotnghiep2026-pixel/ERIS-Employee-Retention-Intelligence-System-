PORT=3000
CORS_ORIGIN=http://localhost:5173
# Điền endpoint thực tế của talentguard VPS hoặc database local đã restore.
# Không dùng mặc định localhost:5433: database đó đã xuất ra schema rỗng.
PGHOST=localhost
PGPORT=5432
PGDATABASE=talentguard
PGUSER=eris_api
PGPASSWORD=replace_locally
# Khi kết nối VPS qua TLS: require + CA hợp lệ; không tắt xác minh chứng chỉ.
PGSSLMODE=disable
# PGSSLROOTCERT=C:/path/to/ca.pem
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_characters
# Tên role thực tế phải khớp chính xác với roles.name trong database.
ROLE_ADMIN=SYSTEM_ADMIN
ROLE_HR_STAFF=HR_STAFF
ROLE_HR_MANAGER=HR_MANAGER
ROLE_ANALYST=DATA_AI_ANALYST
