PORT=3000
CORS_ORIGIN=http://localhost:5173
# Điền endpoint thực tế của talentguard VPS hoặc database local đã restore.
# Không dùng mặc định localhost:5433: database đó đã xuất ra schema rỗng.
PGHOST=localhost
PGPORT=5432
PGDATABASE=talentguard
PGUSER=eris_api
PGPASSWORD=replace_locally
# Khi kết nối VPS qua TLS: require + CA hợp lệ; không tắt xác minh chứng chỉ.
PGSSLMODE=disable
# PGSSLROOTCERT=C:/path/to/ca.pem
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_characters
# Tên role thực tế phải khớp chính xác với roles.name trong database.
ROLE_ADMIN=ADMIN
ROLE_HR_STAFF=HR_STAFF
ROLE_HR_MANAGER=HR_MANAGER
ROLE_ANALYST=AI_ANALYST
NODE_ENV=development
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_SECONDS=604800
RESET_TOKEN_TTL_SECONDS=1800
# Production: HTTPS frontend + AUTH_COOKIE_SECURE=true required.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
PASSWORD_RESET_URL=http://localhost:5173/reset-password
# Leave SMTP_HOST empty until an SMTP account is configured. No reset token is logged.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
