PORT=3000
CORS_ORIGIN=http://localhost:5173
# Điền endpoint thực tế của talentguard VPS hoặc database local đã restore.
# Không dùng mặc định localhost:5433: database đó đã xuất ra schema rỗng.
PGHOST=localhost
PGPORT=5432
PGDATABASE=talentguard
PGUSER=eris_api
PGPASSWORD=replace_locally
# Khi kết nối VPS qua TLS: require + CA hợp lệ; không tắt xác minh chứng chỉ.
PGSSLMODE=disable
# PGSSLROOTCERT=C:/path/to/ca.pem
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_characters
# Tên role thực tế phải khớp chính xác với role.name trong database.
ROLE_ADMIN=ADMIN
ROLE_HR=HR
ROLE_EMPLOYEE=EMPLOYEE
NODE_ENV=development
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_SECONDS=604800
PASSWORD_RESET_OTP_TTL_SECONDS=900
PASSWORD_RESET_OTP_MAX_ATTEMPTS=5
PASSWORD_CHANGE_TOKEN_TTL_SECONDS=900
REDIS_URL=redis://127.0.0.1:6379
INITIAL_USER_PASSWORD=Testpassword123!
# Production: HTTPS frontend + AUTH_COOKIE_SECURE=true required.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
# Leave SMTP_HOST empty until an SMTP account is configured. OTP values are never logged.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Vietmap converts Vietnamese addresses to coordinates; TomTom calculates the stable road route.
VIETMAP_API_KEY=
VIETMAP_BASE_URL=https://maps.vietmap.vn
TOMTOM_API_KEY=
TOMTOM_BASE_URL=https://api.tomtom.com
ROUTING_TIMEOUT_MS=10000

# Fixed company destination for distance calculation.
COMPANY_LATITUDE=10.841158444047021
COMPANY_LONGITUDE=106.81020893790844
COMPANY_LOCATION_LABEL=FPT University HCMC
